    {
        "id": "8d68c21650184fe3",
        "type": "function",
        "z": "477d9d4af4dd047a",
        "name": "RISING EDGE",
        "func": "let value = msg.payload[0];\nlet state = value;\n\nlet prev = flow.get('prev') || false;\n\nif(state && !prev){\n    if(value ===128){\n        let small = flow.get('small') || 0;\n        small++;\n        flow.set('small', small);\n\n        msg.topic = 'small';\n        msg.payload = small;\n    }\n    else     if(value === 192){\n        let big = flow.get('big') || 0;\n        big++;\n        flow.set('big', big);\n\n        msg.topic = 'big';\n        msg.payload = big;\n    }\n\n    flow.set('prev', state);\n    return msg;\n}\n    flow.set('prev', state);\n    return null;",
